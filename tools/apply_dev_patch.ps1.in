$ErrorActionPreference='Stop'; $taskCreated=$false; $taskOld='__OLD_SHA__'; $taskNew='__NEW_SHA__'; try { $taskSource=Join-Path (Get-Location) 'DB2-Private-Android-fixed.apk'; $taskOutput=Join-Path (Get-Location) 'DB2-Private-route342-dev.apk'; $taskTemp=$taskOutput+'.applying'; if (-not (Test-Path -LiteralPath $taskSource)) { throw 'Copy DB2-Private-Android-fixed.apk beside Apply-Dev.bat first'; }; if ((Get-FileHash -LiteralPath $taskSource -Algorithm SHA256).Hash.ToLowerInvariant() -cne $taskOld) { throw 'Original APK checksum mismatch: input is incomplete or wrong'; }; if (Test-Path -LiteralPath $taskOutput) { if ((Get-FileHash -LiteralPath $taskOutput -Algorithm SHA256).Hash.ToLowerInvariant() -ceq $taskNew) { Write-Host 'Development APK already verified'; exit 0; }; throw 'Output already exists with a different checksum'; }; $taskPlan=Get-Content -Raw -LiteralPath 'plan.json' | ConvertFrom-Json; $taskLiteral=[IO.File]::ReadAllBytes((Join-Path (Get-Location) 'literals.bin')); if ($taskPlan.old_sha256 -cne $taskOld -or $taskPlan.new_sha256 -cne $taskNew -or $taskPlan.operations.Count -gt 50000) { throw 'Unexpected patch version'; }; [long]$taskTotal=0; foreach ($taskOp in $taskPlan.operations) { if ($null -ne $taskOp.PSObject.Properties['copy']) { [long]$taskOffset=$taskOp.copy; [long]$taskBound=$taskPlan.old_size; } else { [long]$taskOffset=$taskOp.literal; [long]$taskBound=$taskLiteral.Length; }; [long]$taskSize=$taskOp.size; if ($taskOffset -lt 0 -or $taskSize -le 0 -or ($taskOffset+$taskSize) -gt $taskBound) { throw 'Invalid patch range'; }; $taskTotal+=$taskSize; }; if ($taskTotal -ne $taskPlan.new_size) { throw 'Patch size mismatch'; }; $taskSourceStream=[IO.File]::OpenRead($taskSource); try { $taskDestinationStream=[IO.File]::Open($taskTemp,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write); $taskCreated=$true; try { $taskBuffer=New-Object byte[] 1048576; foreach ($taskOp in $taskPlan.operations) { if ($null -ne $taskOp.PSObject.Properties['copy']) { [void]$taskSourceStream.Seek([long]$taskOp.copy,[IO.SeekOrigin]::Begin); [long]$taskRemaining=$taskOp.size; while ($taskRemaining -gt 0) { $taskRead=$taskSourceStream.Read($taskBuffer,0,[int]([Math]::Min([long]$taskBuffer.Length,$taskRemaining))); if ($taskRead -le 0) { throw 'Truncated source APK'; }; $taskDestinationStream.Write($taskBuffer,0,$taskRead); $taskRemaining-=$taskRead; }; } else { $taskDestinationStream.Write($taskLiteral,[int]$taskOp.literal,[int]$taskOp.size); }; }; } finally { $taskDestinationStream.Dispose(); }; } finally { $taskSourceStream.Dispose(); }; if ((Get-Item -LiteralPath $taskTemp).Length -ne $taskPlan.new_size -or (Get-FileHash -LiteralPath $taskTemp -Algorithm SHA256).Hash.ToLowerInvariant() -cne $taskNew) { throw 'Development APK checksum mismatch'; }; [IO.File]::Move($taskTemp,$taskOutput); $taskCreated=$false; Write-Host 'Development APK created and SHA-256 verified: DB2-Private-route342-dev.apk'; } catch { if ($taskCreated -and (Test-Path -LiteralPath $taskTemp)) { Remove-Item -LiteralPath $taskTemp; }; Write-Host ('ERROR: '+$_.Exception.Message); exit 1; }
