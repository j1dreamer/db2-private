# Replace with the VPS Tailscale IPv4 from: tailscale ip -4
DB2_BIND=100.REPLACE.WITH.IP
# Node LTS must be installed in a path visible to this service.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Optional explicit Node executable if systemd has a minimal PATH.
# DB2_NODE=/opt/db2/node/bin/node
